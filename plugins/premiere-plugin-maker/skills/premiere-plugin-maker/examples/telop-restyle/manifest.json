{
  "manifestVersion": 5,
  "id": "com.example.teloprestyle",
  "name": "Telop Restyle",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.2",
    "data": {
      "apiVersion": 2,
      "loadEvent": "startup"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": {
        "default": "テロップ一括デザイン"
      },
      "minimumSize": {
        "width": 260,
        "height": 240
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 460
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 520
      }
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": "generic"
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": "all"
    }
  },
  "featureFlags": {}
}
